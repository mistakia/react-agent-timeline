@import '../styles/tokens.styl'

.rat-timeline
  display flex
  flex-direction column
  gap $rat_space_sm
  color $rat_text
  font-size $rat_font_size_md

.rat-timeline-entries
  display flex
  flex-direction column
  min-width 0

// THE COLLAPSED SURFACE IS ONE LINE: a caption saying what it is, then the row.
//
// Laid out as a row rather than as a caption stacked over the entry, because
// this is a status line -- it shows whatever the agent is doing right now and
// it changes on every live entry, so every pixel of height it takes is height
// the host panel gains and gives back while someone is reading. The row's own
// one-line clamp lives in the row stylesheet and now holds in both views.
.rat-timeline:not(.rat-timeline-expanded) .rat-timeline-entries
  flex-direction row
  align-items baseline
  gap $rat_space

.rat-timeline:not(.rat-timeline-expanded) .rat-event-row
  flex 1 1 0%
  min-width 0

// The word that says the line beneath the panel is the NEWEST event and not a
// summary of the run. Set as a caption -- the same small uppercase the row
// labels use -- with a rule down its right edge as the only mark separating it
// from the entry it introduces.
.rat-timeline-latest
  flex none
  align-self center
  padding-right $rat_space
  border-right 1px solid $rat_border
  color $rat_text_subtle
  font-size $rat_font_size_xs
  font-weight 600
  letter-spacing 0.04em
  text-transform uppercase
  white-space nowrap

// Expansion is where an unbounded list would grow the host panel instead of
// scrolling inside it. A fifteen-minute run is hundreds of entries.
//
// `overflow-anchor: none` because the browser's own scroll anchoring fights the
// pin: appending below the viewport is exactly the case Chrome anchors against,
// and it holds the previous entry in place a moment after our scroll write.
//
// RULED RATHER THAN BOXED: a rule above and below, no side borders and no
// radius. A bordered rounded rectangle around the list is a card, which is the
// one construction the consuming design system rules out, and it read as a
// panel-within-a-panel when it was one.
.rat-timeline-expanded .rat-timeline-entries
  max-height $rat_expanded_max_height
  overflow-y auto
  overflow-anchor none
  border-top 1px solid $rat_border_strong
  border-bottom 1px solid $rat_border
  background $rat_bg

// Where one entry ends and the next begins, which nothing else says once the
// bodies wrap. An expanded run is mostly multi-line tool arguments set flush
// against each other, and with no blank line between them the list reads as one
// block of text with a label column beside it. Between entries only -- a rule
// under the last one draws a floor part-way down the scroll box.
.rat-timeline-expanded .rat-event-row + .rat-event-row
  border-top 1px solid $rat_divider

.rat-timeline-empty
  padding $rat_space_xs $rat_space
  color $rat_text_subtle

.rat-timeline-footer
  display flex
  align-items center
  gap $rat_space

// The readings about the run, held together beside the control rather than
// pushed to the far end of the row. The panel this sits in has no declared
// width on every surface -- the share page runs the full page -- so `margin-left
// auto` put the tally and the clock a thousand pixels from the button and the
// footer read as two unrelated things. The button's outline is what separates
// the control from the readings; distance is not needed for it and cannot be
// relied on at an unknown width.
.rat-timeline-meta
  display flex
  align-items baseline
  gap $rat_space
  margin-left $rat_space_sm

// AN OUTLINED BUTTON, NOT A TEXT ACTION. It shares a row with a tool tally and
// a clock, and as bare underlined text it was the same object as its
// neighbours -- a reader had to try it to find out it did something. Flat by
// construction all the same: a hairline rule and the smallest radius, no fill
// and no shadow, so it reads as pressable without becoming the loudest thing on
// a panel it sits at the bottom of.
.rat-timeline-toggle,
.rat-timeline-jump
  align-self flex-start
  display inline-flex
  align-items center
  gap $rat_space_sm
  padding $rat_space_xs $rat_space
  border 1px solid $rat_border
  border-radius $rat_radius_sm
  background transparent
  color $rat_accent
  font-size $rat_font_size_sm
  font-weight 600
  letter-spacing 0.02em
  text-transform uppercase
  cursor pointer

  &:hover
    border-color $rat_border_strong
    background $rat_bg_hover

  &:focus-visible
    outline 1px solid $rat_accent
    outline-offset 2px

// The same `+` / `-` glyph the row disclosure uses, so the two controls that
// reveal things on this surface say so the same way. Drawn by the stylesheet
// rather than placed in the markup, which keeps the button's text exactly the
// word the consumer supplied and nothing else.
.rat-timeline-toggle::before
  content '+'
  font-family $rat_font_mono
  font-weight 400

.rat-timeline-toggle[aria-expanded='true']::before
  content '\2212'

.rat-timeline-jump
  margin-top $rat_space_sm

.rat-timeline-count,
.rat-timeline-duration
  color $rat_text_subtle
  font-size $rat_font_size_sm
  font-variant-numeric tabular-nums

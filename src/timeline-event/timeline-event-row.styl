@import '../styles/tokens.styl'

.rat-event-row
  // THE ROW IS ALSO A FLEX ITEM, and this is the declaration that keeps it from
  // being crushed by the list above it.
  //
  // `.rat-timeline-entries` is a column flex container, and expanded it carries
  // a max-height and scrolls. That makes its height DEFINITE, so its items
  // resolve `flex-shrink: 1` against it and every row is squeezed toward the
  // 24px floor below while its wrapped body still needs its full height. The
  // overflow is not clipped -- it paints over the row underneath, so a run of
  // multi-line tool calls renders as lines of text stacked on top of each
  // other, which is what the surface looked like before this line: rows 28px
  // tall holding 48px of text, each one bleeding 20px into its neighbour.
  //
  // `min-height` is NOT the guard against this -- it is the floor the shrink
  // squeezes down TO.
  flex none
  display flex
  flex-direction column
  color $rat_text
  font-size $rat_font_size_md
  line-height 1.4

// The horizontal half of the row. Split out from .rat-event-row when tool rows
// gained a detail block below them: the row became a column so it could stack
// main-over-detail, and everything that was aligning label against body had to
// move down one level with it.
.rat-event-row-main
  display flex
  align-items baseline
  gap $rat_space
  width 100%
  min-height $rat_row_min_height
  padding $rat_space_xs $rat_space
  text-align left

// The <button> variant, which needs its user-agent styling stripped before it
// can look like the <div> variant beside it.
.rat-event-row-toggle
  border none
  background transparent
  color inherit
  font-family inherit
  font-size inherit
  line-height inherit
  cursor pointer

  &:hover
    background $rat_bg_hover

  &:focus-visible
    outline 1px solid $rat_accent
    outline-offset -1px

.rat-event-marker
  flex none
  width 9px
  color $rat_text_subtle
  font-family $rat_font_mono
  font-size $rat_font_size_sm
  // A `+` and a `−` are different widths in most proportional faces and even in
  // some monospace ones at small sizes; centring in a fixed slot keeps the
  // label column from shifting by a pixel every time a row is opened.
  text-align center

// A COLUMN, NOT A PREFIX. `min-width` rather than `width`, so the four fixed
// words -- You, Thinking, Assistant, System -- line their bodies up at one left
// edge and the list reads as a table of what happened, while a tool NAME, which
// is an identifier of any length, is still allowed to push past it rather than
// being truncated into a different string.
.rat-event-label
  flex none
  min-width $rat_label_width
  font-size $rat_font_size_sm
  font-weight 600
  letter-spacing 0.02em
  text-transform uppercase
  color $rat_text_subtle

// ONE LINE IS THE DEFAULT FOR EVERY ROW, and the exceptions are written where
// they are earned: the assistant message, whose prose is the run's own account
// of itself, and an opened detail block.
//
// This used to be scoped to the COLLAPSED timeline, on the reasoning that the
// expanded list is where a reader wants everything. It is not: a run's thinking
// entries are twenty lines each and there are dozens of them, so unclamped they
// filled the panel end to end and the tool calls between them were unreachable
// without scrolling past someone else's deliberation. Clamped, the list is a
// list of steps and the full text is one click away on the row that holds it.
.rat-event-body
  flex 1 1 auto
  min-width 0
  overflow-wrap anywhere
  white-space nowrap
  overflow hidden
  text-overflow ellipsis

.rat-event-row-muted .rat-event-body
  color $rat_text_muted
  font-style italic

// A reading about the row, at its right edge: how long a call took, when that
// was long enough to be worth saying.
//
// `flex none` so it is never the thing that truncates — the body clamps, the
// number does not, because a number cut in half is a wrong number rather than a
// shortened one. Tabular figures so a column of them lines up on the decimal
// and a reader can compare two rows without reading either.
.rat-event-meta
  flex none
  align-self baseline
  color $rat_text_subtle
  font-family $rat_font_mono
  font-size $rat_font_size_xs
  font-variant-numeric tabular-nums
  white-space nowrap

// THE TOOL'S OWN FACE, worn by every row whose body is a tool's payload — the
// recorded call, a shell invocation the consumer left unresolved, an errored
// call and an orphan result. The face is what identifies a tool line at a
// glance now that the argument draws no box around itself.
.rat-event-row-tool-call .rat-event-body,
.rat-event-row-tool-bash .rat-event-body,
.rat-event-row-tool-error .rat-event-body,
.rat-event-row-tool-result .rat-event-body
  font-family $rat_font_mono
  font-size $rat_font_size_sm

.rat-event-row-tool-error .rat-event-body
  color $rat_text_error

// A revealed tool result, set behind a rule rather than inside a box.
//
// The indent plus an inset top rule is the containment device here: it says
// "this belongs to the row above" without drawing a card, which is the one
// thing the consuming design system rules out. A left rule was the original
// device and read as a quote or an error margin next to every open result, so
// it is gone and the seam moved to the top edge, where the boundary it draws is
// between the row's own header and its continuation rather than between the
// result and the page.
.rat-event-detail
  margin $rat_space_xs 0 $rat_space_sm 0
  // Indents past the marker slot and the gap, so the seam hangs under the
  // label rather than under the row's left edge.
  margin-left $rat_space_lg
  border-top 1px solid $rat_border
  padding-top $rat_space_sm
  padding-left $rat_space_lg
  max-height $rat_detail_max_height
  overflow-y auto
  color $rat_text_muted
  font-family $rat_font_mono
  font-size $rat_font_size_sm
  line-height 1.5
  white-space pre-wrap
  overflow-wrap anywhere

.rat-event-detail-error
  color $rat_text_error

// THE HEADER OF AN OPEN ROW STAYS PUT WHILE ITS RESULT SCROLLS, scoped to the
// expanded list (the only place a row's main and its fate can be separated by
// more than the row's own height).
//
// `.rat-event-row` is a column flex of main-over-detail, and the entries list
// is the scroll container, so sticking the main at the container's top keeps
// the tool name readable for a result taller than the panel -- exactly the
// result the reader opened. Sticky is bounded by the row's own box, so the
// header releases the moment the ROW scrolls past, never lingering over a
// sibling entry.
//
// The opaque ground is what hides the neighbouring row sliding underneath; a
// transparent header would print two entries' text over each other. User
// message rows carry their own ground, so they keep it.
.rat-timeline-expanded .rat-event-row-open .rat-event-row-main
  position sticky
  top 0
  z-index 1
  background $rat_bg

.rat-timeline-expanded .rat-event-row-open.rat-event-row-user-message .rat-event-row-main
  background $rat_bg_subtle

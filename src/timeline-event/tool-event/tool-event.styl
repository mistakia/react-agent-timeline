@import '../../styles/tokens.styl'

// The tool NAME takes the label slot, so it is not uppercased with the rest of
// them. `search_columns` and `run_sql` are identifiers a reader matches against
// what they know is installed, and case-folding an identifier makes it a
// different string on sight.
.rat-tool-name
  text-transform none
  font-family $rat_font_mono
  font-weight 600
  color $rat_text

.rat-event-row-tool-error .rat-tool-name
  color $rat_text_error

.rat-event-row-tool-error .rat-event-label
  color $rat_text_error

// The argument, on the row's own ground. NOT a chip.
//
// A run is mostly tool calls, so a bordered box per argument is dozens of boxes
// down the list, on a surface whose stated rule is "rules, not boxes". The box
// carried no structure the row does not already have: the mono face comes from
// the shared row rule and the one-line clamp from `.rat-event-body`, and what
// distinguishes the argument from the rest of the row is that face -- the same
// device every distinctive line on this surface uses. The field captions below
// keep a multi-field answer legible without a container around it.
//
// Clamping, not wrapping, is still the whole of the row's shape: these
// arguments are routinely a kilobyte of single-line JSON, and a body allowed to
// wrap would be twenty lines tall in a list whose job is to be scannable. The
// full text is behind the row's disclosure.

// The identifying fields inside the chip, when the consumer supplied them.
//
// ONE CHIP HOLDING SEVERAL FIELDS, not one chip each. The fields are a single
// answer to "what was this call about" — a query AND the grain it ran at — and
// splitting them into separate grounds would read as separate arguments to
// separate things. What separates them inside the chip is the caption face and
// a gap, which is the same device the row's own label column uses.
// BLOCK-LEVEL FLEX, NOT INLINE-FLEX, and that is what makes a long argument
// truncate instead of being sheared off. `.rat-event-body` carries the row's
// `overflow: hidden` and `text-overflow: ellipsis`, but an ellipsis can only be
// drawn on a text node — an inline-flex child sizes itself to max-content and
// simply overflows past the clip, so the same run of SQL that gets a `…` on a
// thinking row was cut mid-glyph at the panel's edge on every field-rendered
// one. Filling the body's width instead lets the fields shrink inside it and
// the value below draw its own ellipsis.
.rat-tool-fields
  display flex
  align-items baseline
  gap $rat_space
  min-width 0
  flex 1 1 auto
  overflow hidden

.rat-tool-field
  display flex
  align-items baseline
  gap $rat_space_sm
  min-width 0

// Which field this is, in the same small uppercase the row labels and the
// detail captions use, so a reader learns one caption face on this surface
// rather than three.
.rat-tool-field-label
  flex none
  color $rat_text_subtle
  font-family $rat_font_mono
  font-size $rat_font_size_xs
  font-weight 600
  letter-spacing 0.02em
  text-transform uppercase

// The value carries the ink, because the value is the answer. Clamped like
// everything else on a row: the body is one line and a long query truncates
// rather than wrapping the list open.
.rat-tool-field-value
  min-width 0
  color $rat_text
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

// A field the consumer marked as a failure. The accent is spent on exactly one
// register -- the value that says a call did not produce its answer.
.rat-tool-field-value--error
  color $rat_text_error

// A FAILED CALL'S FIELDS ARE FAILED FIELDS, which the row rule alone cannot
// say. `.rat-event-row-tool-error .rat-event-body` sets the error ink, and the
// value rule above it re-declares `$rat_text` on the very span that carries the
// text -- so an errored call rendered its argument in ordinary ink and the only
// mark of the failure was the tool name. Measured on production: an errored
// `run_sql` drew its statement at `rgb(68, 68, 68)` inside a body computing the
// error ink. This is the same override the path spans below already restate for
// the same reason.
.rat-event-row-tool-error .rat-tool-field-value
  color $rat_text_error

// A path argument: the file in full ink, the directories ahead of it set back.
//
// TWO WEIGHTS OF ONE STRING, not two elements a reader has to join. The prefix
// and the name sit flush against each other with no separator, so the line still
// reads as one path — what the contrast does is tell a reader scanning a column
// of file rows where to put their eye, which is the last segment every time.
//
// The name is allowed to shrink but never before the prefix does: on a narrow
// panel the directories give way and the filename survives, which is the whole
// reason the two are separate elements.
// Block-level flex for the same reason `.rat-tool-fields` is: inside an
// inline-flex sized to max-content neither span shrinks, so a path longer than
// the panel shears at the clip instead of giving way at the prefix.
.rat-tool-path
  display flex
  align-items baseline
  min-width 0
  flex 1 1 auto
  overflow hidden

.rat-tool-path-prefix
  flex 0 1 auto
  min-width 0
  color $rat_text_subtle
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

.rat-tool-path-name
  flex 0 0 auto
  color $rat_text
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

// A failed read still reads as failed. The row rule colours `.rat-event-body`,
// which these two spans sit inside and override, so the error ink has to be
// restated here or a path row is the one kind of row whose failure is invisible.
.rat-event-row-tool-error .rat-tool-path-name
  color $rat_text_error

// One captioned block inside a revealed row: the full argument, or the result.
.rat-tool-section + .rat-tool-section
  margin-top $rat_space

// A shell row's reveal reads as one terminal: the full command, then the output
// cut below by the seam base draws between the two. Rule rather than box -- the
// border is the boundary, the ground never changes.
.rat-event-row-tool-bash .rat-tool-section + .rat-tool-section
  margin-top 0
  border-top 1px solid $rat_border
  padding-top $rat_space

.rat-tool-caption
  display block
  margin-bottom $rat_space_xs
  color $rat_text_subtle
  font-size $rat_font_size_xs
  font-weight 600
  letter-spacing 0.02em
  text-transform uppercase

.rat-tool-text
  white-space pre-wrap
  overflow-wrap anywhere

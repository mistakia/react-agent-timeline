@import '../../styles/tokens.styl'

// The tool NAME takes the label slot, so it is not uppercased with the rest of
// them. `search_columns` and `run_sql` are identifiers a reader matches against
// what they know is installed, and case-folding an identifier makes it a
// different string on sight.
.rat-tool-name
  text-transform none
  font-family $rat_font_mono
  font-weight 600
  color $rat_text

.rat-event-row-tool-error .rat-tool-name
  color $rat_text_error

.rat-event-row-tool-error .rat-event-label
  color $rat_text_error

// The argument, set as a chip against its own ground.
//
// Flat by construction: a hairline rule and a 2px radius, no shadow and no
// raise. What separates it from the row is the ground shift and the rule, which
// is the same device the rest of this surface uses.
//
// Clamped to one line unconditionally -- not only in the collapsed timeline.
// These arguments are routinely a kilobyte of single-line JSON, and a chip
// allowed to wrap would be twenty lines tall in a list whose whole job is to be
// scannable. The full text is behind the row's disclosure.
//
// The shell row shares the chip: a genuinely-unresolved bash call is still a
// command on one line, and the `$ ` prompt belongs on the same ground as the
// chip rather than on a label of its own.
.rat-event-row-tool-call .rat-event-body,
.rat-event-row-tool-bash .rat-event-body
  align-self center
  padding 1px $rat_space_sm
  border 1px solid $rat_border
  border-radius $rat_radius_sm
  background $rat_field
  color $rat_text_muted
  white-space nowrap
  overflow hidden
  text-overflow ellipsis

.rat-event-row-tool-call .rat-event-row-toggle:hover .rat-event-body,
.rat-event-row-tool-bash .rat-event-row-toggle:hover .rat-event-body
  border-color $rat_border_strong
  color $rat_text

// The identifying fields inside the chip, when the consumer supplied them.
//
// ONE CHIP HOLDING SEVERAL FIELDS, not one chip each. The fields are a single
// answer to "what was this call about" — a query AND the grain it ran at — and
// splitting them into separate grounds would read as separate arguments to
// separate things. What separates them inside the chip is the caption face and
// a gap, which is the same device the row's own label column uses.
.rat-tool-fields
  display inline-flex
  align-items baseline
  gap $rat_space
  min-width 0

.rat-tool-field
  display inline-flex
  align-items baseline
  gap $rat_space_sm
  min-width 0

// Which field this is, in the same small uppercase the row labels and the
// detail captions use, so a reader learns one caption face on this surface
// rather than three.
.rat-tool-field-label
  flex none
  color $rat_text_subtle
  font-family $rat_font_mono
  font-size $rat_font_size_xs
  font-weight 600
  letter-spacing 0.02em
  text-transform uppercase

// The value carries the ink, because the value is the answer. Clamped like
// everything else on a row: the chip is one line and a long query truncates
// rather than wrapping the list open.
.rat-tool-field-value
  min-width 0
  color $rat_text
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

// One captioned block inside a revealed row: the full argument, or the result.
.rat-tool-section + .rat-tool-section
  margin-top $rat_space

// A shell row's reveal reads as one terminal: the full command, then the output
// cut below by the seam base draws between the two. Rule rather than box -- the
// border is the boundary, the ground never changes.
.rat-event-row-tool-bash .rat-tool-section + .rat-tool-section
  margin-top 0
  border-top 1px solid $rat_border
  padding-top $rat_space

.rat-tool-caption
  display block
  margin-bottom $rat_space_xs
  color $rat_text_subtle
  font-size $rat_font_size_xs
  font-weight 600
  letter-spacing 0.02em
  text-transform uppercase

.rat-tool-text
  white-space pre-wrap
  overflow-wrap anywhere

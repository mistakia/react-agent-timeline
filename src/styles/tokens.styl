// react-agent-timeline design tokens.
//
// Every .styl file in this package imports this one at its top. That is not a
// convention, it is what makes the package self-sufficient: a consumer whose
// stylus rule injects only its OWN variables would otherwise compile our files
// with every $rat_* undefined, and Stylus emits nothing for an unknown variable
// rather than erroring. The failure is a silently blank declaration, not a
// build error.
//
// Values indirect through --rat-* CSS custom properties so a consumer can
// restyle at runtime by redefining them on :root (or any ancestor scope),
// without rebuilding the package.
//
// THE DEFAULTS ARE FLAT AND RULED, AND THAT IS A DECISION RATHER THAN A
// STARTING POINT. There is no shadow token here and no radius above 3px,
// because the one consuming application carries a design system whose stated
// rules are "rules, not boxes" and "no shadows for depth". A package whose
// defaults were cards and drop shadows would be corrected by an override block
// in that consumer on the first render, which is two places to change one
// look. Structure here is carried by rules, alignment and type weight -- the
// same things the consumer uses -- so the override block does not need to
// exist. A future consumer that does want depth adds it through --rat-* and
// nothing in the package resists.

$rat_bg = var(--rat-bg, #ffffff)
$rat_bg_subtle = var(--rat-bg-subtle, #fafafa)
$rat_bg_hover = var(--rat-bg-hover, rgba(23, 24, 26, 0.045))
$rat_border = var(--rat-border, #d9dadd)
$rat_border_strong = var(--rat-border-strong, #17181a)
$rat_divider = var(--rat-divider, #ebecee)

$rat_text = var(--rat-text, #17181a)
$rat_text_muted = var(--rat-text-muted, #55585e)
$rat_text_subtle = var(--rat-text-subtle, #83878e)
$rat_text_error = var(--rat-text-error, #9b1c1c)
// One accent, spent on interaction and error and nothing else. Defaulted to the
// same deep red as the error ink rather than to a second hue: a timeline has no
// third state that earns its own colour, and two reds that differ slightly read
// as a mistake rather than as a distinction.
$rat_accent = var(--rat-accent, #9b1c1c)

$rat_space_xs = var(--rat-space-xs, 2px)
$rat_space_sm = var(--rat-space-sm, 4px)
$rat_space = var(--rat-space, 8px)
$rat_space_lg = var(--rat-space-lg, 12px)

$rat_radius_sm = var(--rat-radius-sm, 2px)
$rat_radius = var(--rat-radius, 3px)

$rat_font_size_xs = var(--rat-font-size-xs, 10px)
$rat_font_size_sm = var(--rat-font-size-sm, 11px)
$rat_font_size_md = var(--rat-font-size-md, 13px)
$rat_font_mono = var(--rat-font-mono, ui-monospace, SFMono-Regular, Menlo, monospace)

$rat_row_min_height = var(--rat-row-min-height, 24px)
// How wide the label column is before a label is allowed to push it. Sized for
// the longest fixed word the package renders (`THINKING` at the small size), so
// every one of them lines its body up at the same left edge. `ASSISTANT` used
// to set this width and no longer exists — the assistant row carries no label.
$rat_label_width = var(--rat-label-width, 56px)
$rat_expanded_max_height = var(--rat-expanded-max-height, 320px)
// How far a revealed tool result may run before it scrolls inside its own row.
// A result is unbounded text and the panel above it already scrolls; without a
// ceiling here one 4kB result makes the outer scrollbar meaningless.
$rat_detail_max_height = var(--rat-detail-max-height, 180px)
